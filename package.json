{
  "name": "singulo",
  "version": "0.2.2",
  "description": "A local picture archive with safe imports and duplicate review",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "npm run test:comparison && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:comparison": "node --test tests/comparison.test.mjs",
    "desktop": "tauri dev",
    "prepare:media": "node scripts/prepare-media.mjs",
    "fetch:media": "node scripts/fetch-media.mjs",
    "version": "node scripts/sync-version.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
