{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Singulo",
  "version": "../package.json",
  "identifier": "com.nosmallthing.singulo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Singulo",
        "width": 1180,
        "height": 820,
        "minWidth": 850,
        "minHeight": 640
      },
      {
        "label": "viewer",
        "title": "Singulo Viewer",
        "url": "/?window=viewer",
        "width": 1100,
        "height": 800,
        "create": false
      },
      {
        "label": "drop",
        "title": "Drop into Singulo",
        "url": "/?window=drop",
        "width": 340,
        "height": 380,
        "create": false,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/tools/": "tools/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
